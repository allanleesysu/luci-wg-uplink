#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=10
start_service() {
 procd_open_instance
 procd_set_param command /usr/sbin/wg-uplink daemon
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
reload_service() { /usr/sbin/wg-uplink kick >/dev/null 2>&1; }
service_triggers() { procd_add_reload_trigger wg_uplink network; }
